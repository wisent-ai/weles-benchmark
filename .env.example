FIXTURE_HOST=127.0.0.1
FIXTURE_ORIGIN=http://127.0.0.1:8787

WELES_API_BASE=http://dedicated-host:8788
WELES_TOKEN=replace-with-workload-scoped-token

# Required for --adapter stagehand: the Brama address this machine reaches,
# as `stado service directory connect brama` reports it. No default is built in.
BRAMA_BASE_URL=replace-with-brama-base-url
BRAMA_API_KEY=replace-with-workload-scoped-token
BRAMA_MODEL=weles/agent/primary
BROWSER_EXECUTABLE_PATH=/absolute/path/to/Chromium
BROWSER_USE_PYTHON=.venv/bin/python

SKYVERN_API_KEY=replace-with-skyvern-api-key
SKYVERN_BASE_URL=https://api.skyvern.com
SKYVERN_ENGINE=skyvern-2.0
