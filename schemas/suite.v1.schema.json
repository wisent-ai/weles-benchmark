{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wisent-ai/weles-benchmark/schemas/suite.v1.schema.json",
  "title": "Weles benchmark suite v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "name", "version", "description", "defaults", "cases"],
  "properties": {
    "schema": { "const": "weles.benchmark.suite.v1" },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repetitions", "concurrency", "timeoutMs", "pollIntervalMs"],
      "properties": {
        "repetitions": { "type": "integer", "minimum": 1 },
        "concurrency": { "type": "integer", "minimum": 1 },
        "timeoutMs": { "type": "integer", "minimum": 1000 },
        "pollIntervalMs": { "type": "integer", "minimum": 100 }
      }
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "successRateMin": { "type": "number", "minimum": 0, "maximum": 1 },
        "receiptRateMin": { "type": "number", "minimum": 0, "maximum": 1 },
        "p95DurationMsMax": { "type": "integer", "minimum": 1 }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "origin", "action", "input", "justification", "expected"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "origin": { "type": "string", "minLength": 1 },
          "action": { "type": "string", "minLength": 1 },
          "input": { "type": "object" },
          "justification": { "type": "string", "minLength": 1 },
          "credentialRefs": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "evidencePolicy": { "type": "string", "minLength": 1 },
          "tags": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "expected": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "acceptedStatuses": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
              "receiptRequired": { "type": "boolean" },
              "assertions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["path", "operator"],
                  "properties": {
                    "path": { "type": "string", "pattern": "^/" },
                    "operator": { "enum": ["equals", "exists", "includes"] },
                    "value": true
                  },
                  "allOf": [
                    {
                      "if": { "properties": { "operator": { "enum": ["equals", "includes"] } } },
                      "then": { "required": ["value"] }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
